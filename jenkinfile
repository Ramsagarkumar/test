pipeline {
    agent any

    environment {
        IMAGE_NAME = 'my-python-app'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                '''
            }
        }

        stage('Run Python Application') {
            steps {
                sh '''
                    docker run --rm ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    docker run --rm ${IMAGE_NAME}:${IMAGE_TAG} python app.py
                '''
            }
        }
    }

    post {
        success {
            echo 'Docker image built and Python application ran successfully!'
        }

        failure {
            echo 'Build or Python application failed.'
        }

        always {
            sh '''
                docker image rm ${IMAGE_NAME}:${IMAGE_TAG} || true
                docker image rm ${IMAGE_NAME}:latest || true
            '''
        }
    }
}
